{
  "name": "outbreak-watch",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "detection",
    "pipeline",
    "infra",
    "backend"
  ],
  "scripts": {
    "test": "npm run synth --silent -- --quiet > /dev/null && npm test --workspaces --if-present",
    "synth": "npm run --workspace=@outbreak/infra synth"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "tsx": "^4.23.15"
  }
}
