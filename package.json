{
  "name": "outbreak-watch",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "workspaces": [
    "packages/*",
    "detection",
    "pipeline",
    "infra",
    "backend"
  ],
  "scripts": {
    "test": "npm run synth --silent -- --quiet > /dev/null && npm test --workspaces --if-present",
    "deploy": "npm run --workspace=@outbreak/infra deploy",
    "destroy": "npm run --workspace=@outbreak/infra destroy",
    "synth": "npm run --workspace=@outbreak/infra synth",
    "audit:security": "npx tsx scripts/security-audit.ts",
    "db:setup": "npm run --workspace=@outbreak/backend db:setup",
    "typecheck": "tsc --noEmit -p packages/contract && tsc --noEmit -p pipeline && tsc --noEmit -p backend && tsc --noEmit -p infra",
    "dev": "npm run dev --prefix frontend",
    "dev:all": "bash scripts/dev-all.sh",
    "stop:all": "bash scripts/stop-all.sh",
    "postinstall": "npm install --prefix frontend --no-audit --no-fund"
  },
  "devDependencies": {
    "@types/node": "^26.6.4",
    "typescript": "^7.0.2",
    "vitest": "^5.0.3",
    "tsx": "^4.23.15"
  }
}
