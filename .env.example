# Variable names only. Every value below is FAKE.
# Real keys never go in files: not here, not in code, not in chat.
# Copy to .env (which is ignored) and fill in locally.

# Local database (PostgreSQL + PostGIS), or DB_SECRET_ARN for the RDS secret
DATABASE_URL=postgres://fake_user:fake_password@localhost:5432/fake_db
# DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:000000000000:secret:outbreak/db/credentials-FAKE

# The demo key the frontend sends as X-Demo-Auth (no default in the code)
DEMO_AUTH_TOKEN=fake-demo-token-not-real
AWS_REGION=ap-south-1

# SES: both must be verified identities while SES is in the sandbox. No defaults in the code.
SES_FROM_EMAIL=alerts@example.com
OFFICER_EMAIL=officer@example.com
# BUDGET_EMAIL=billing@example.com   (default: OFFICER_EMAIL)
# SES_MOCK=true                      (log instead of sending)
