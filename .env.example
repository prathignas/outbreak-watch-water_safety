# Local values that work out of the box. No real secrets here: real keys never go in files.
# Copy to .env (ignored by git): cp .env.example .env

# --- npm run dev (Windows or Mac): frontend only, mock mode, no database needed ---
# The frontend reads frontend/.env (see frontend/.env.example); mock mode is the default.
VITE_API_MODE=mock
VITE_DEMO_KEY=watch-demo

# --- npm run dev:all (Mac, full stack: local PostGIS on 5433, API on 3001, frontend on 5173) ---
DATABASE_URL=postgres://outbreak@localhost:5433/outbreak_watch
# The demo key the frontend sends as X-Demo-Auth; the API checks it. Local only.
DEMO_AUTH_TOKEN=watch-demo
WEBHOOK_SECRET=local-webhook-secret
API_URL=http://localhost:3001
PORT=3001
# Log emails instead of sending them (no AWS needed locally).
SES_MOCK=true
SES_FROM_EMAIL=alerts@example.com
OFFICER_EMAIL=officer@example.com
AWS_REGION=ap-south-1

# --- AWS deploy only (not needed locally) ---
# DB_SECRET_ARN=arn:aws:secretsmanager:ap-south-1:000000000000:secret:outbreak/db/credentials-FAKE
# BUDGET_EMAIL=billing@example.com   (default: OFFICER_EMAIL)
