# mock = MSW answers every route in the browser (no backend). real = call VITE_API_BASE_URL.
VITE_API_MODE=mock
# Real mode only: the API base URL from P3, e.g. https://abc123.execute-api.ap-south-1.amazonaws.com/prod
VITE_API_BASE_URL=
# Mock mode: the demo key the in-browser mock accepts (real mode: the server checks it).
VITE_DEMO_KEY=watch-demo
